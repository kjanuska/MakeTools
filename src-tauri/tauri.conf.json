{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Make Tools",
  "version": "0.1.0",
  "identifier": "com.kipras.maketools",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Make Tools",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERGN0EwRjQyQUI3MUM4NEMKUldSTXlIR3JRZzk2MzJCNEV2NjFSTUxmZTVvUm01aXZlanVPZGRlUkl1bkpyMUhJVFQvTW43TlMK",
      "endpoints": [
        "https://github.com/kjanuska/MakeTools/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
